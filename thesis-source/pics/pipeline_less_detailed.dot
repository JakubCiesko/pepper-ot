digraph PipelineModes {
    rankdir = TB;
//    splines = ortho;
 //   compound = true;
    nodesep = 0.35;
    ranksep = 0.60;
    pad = 0.45;
    bgcolor = "white";
    
    graph [fontname = "Helvetica";];
    node [fontname = "Helvetica"; fontsize = 11; shape = box; style = "rounded,filled"; color = "#000000"; penwidth = 1.2; margin = "0.14,0.10";];
    edge [fontname = "Helvetica"; fontsize = 8; color = "#000000"; penwidth = 1.0; arrowsize = 0.75;];
    
    IN [label = "Frame request\nimage + RobotMetadata";fillcolor = "#F2D45C";];
    PRE [label = "API preprocessing\nresize + metadata parsing";fillcolor = "white";];
    MODE [label = "Execution mode";shape = diamond;style = "filled";fillcolor = "#FFF2CC";margin = "0.08,0.06";];
    
    subgraph cluster_seq {
        label = "Sequential mode";
        color = "#666666";
        penwidth = 1.2;
        style = "rounded,dashed";
        bgcolor = "#F7F7F7";
        
        S_CAP [label = "Captioner";fillcolor = "white";];
        S_DET [label = "Detector";fillcolor = "white";];
        S_READY [label = "Caption + detections ready";fillcolor = "white";];
        
        S_CAP -> S_DET [label = "caption carried forward";];
        S_DET -> S_READY;
    }
    
    subgraph cluster_par {
        label = "Parallel mode";
        color = "#4E8B57";
        penwidth = 1.2;
        style = "rounded,dashed";
        bgcolor = "#ECF4EA";
        
        P_SPLIT [label = "";shape = point;width = 0.06;height = 0.06;style = filled;color = "#000000";fillcolor = "#000000";];
        P_CAP [label = "Captioner";fillcolor = "white";];
        P_DET [label = "Detector";fillcolor = "white";];
        P_JOIN [label = "Join caption + detections";fillcolor = "white";];
        
        P_SPLIT -> P_CAP;
        P_SPLIT -> P_DET;
        P_CAP -> P_JOIN;
        P_DET -> P_JOIN;
    }
    
    TRACK [label = "Tracker + SceneMemory\nReID, association, robot fusion";fillcolor = "white";];
    SOM [label = "SoM painter\nannotated frame";fillcolor = "white";];
    SG [label = "SceneGraphService\nrules / RelTR / VLM";fillcolor = "white";];
    MEM [label = "Memory + QA updates\nrelations, captions, QA pool";fillcolor = "white";];
    OUT [label = "PipelineResult\nAPI response + dashboard event";fillcolor = "#F2D45C";];
    CHAT [label = "ChatService\nfollow-up dialogue";fillcolor = "white";];
    
    IN -> PRE -> MODE;
    
    MODE -> S_CAP [label = "sequential"; lhead = cluster_seq;];
    MODE -> P_SPLIT [label = "parallel"; lhead = cluster_par;];
    
    S_READY -> TRACK;
    P_JOIN -> TRACK;
    
    TRACK -> SOM -> SG -> MEM -> OUT;
    MEM -> CHAT [style = dashed; label = "scene_state";];
}

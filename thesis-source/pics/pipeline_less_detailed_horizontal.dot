digraph PipelineModesLR {
    rankdir = LR;
    splines = ortho;
    compound = true;
    nodesep = 0.28;
    ranksep = 0.45;
    pad = 0.35;
    bgcolor = "white";

    graph [fontname = "Helvetica"];
    node [
        fontname = "Helvetica",
        fontsize = 10,
        shape = box,
        style = "rounded,filled",
        color = "#000000",
        penwidth = 1.1,
        margin = "0.12,0.08"
    ];
    edge [
        fontname = "Helvetica",
        fontsize = 8,
        color = "#000000",
        penwidth = 1.0,
        arrowsize = 0.75
    ];

    IN   [label = "Frame request\nimage + robot metadata", fillcolor = "#F2D45C"];
    PRE  [label = "API preprocessing\nresize + metadata parsing", fillcolor = "white"];
    MODE [label = "Execution\nmode", shape = diamond, style = "filled", fillcolor = "#FFF2CC", margin = "0.08,0.05"];

    subgraph cluster_seq {
        label = "Sequential mode";
        color = "#666666";
        penwidth = 1.1;
        style = "rounded,dashed";
        bgcolor = "#F7F7F7";

        S_CAP   [label = "Captioner", fillcolor = "white"];
        S_DET   [label = "Detector", fillcolor = "white"];
        S_READY [label = "Caption + detections", fillcolor = "white"];

        S_CAP -> S_DET   [label = "caption carried forward"];
        S_DET -> S_READY;
    }

    subgraph cluster_par {
        label = "Parallel mode";
        color = "#4E8B57";
        penwidth = 1.1;
        style = "rounded,dashed";
        bgcolor = "#ECF4EA";

        P_SPLIT [label = "", shape = point, width = 0.06, height = 0.06, style = filled, color = "#000000", fillcolor = "#000000"];
        P_CAP   [label = "Captioner", fillcolor = "white"];
        P_DET   [label = "Detector", fillcolor = "white"];
        P_JOIN  [label = "Join caption\n+ detections", fillcolor = "white"];

        P_SPLIT -> P_CAP;
        P_SPLIT -> P_DET;
        P_CAP   -> P_JOIN;
        P_DET   -> P_JOIN;
    }

    TRACK [label = "Tracking + memory update\nReID, association, robot fusion", fillcolor = "white"];
    SOM   [label = "SoM annotation", fillcolor = "white"];
    SG    [label = "Scene graph generation\nrules / RelTR / VLM", fillcolor = "white"];
    MEM   [label = "Memory + QA update", fillcolor = "white"];
    OUT   [label = "Pipeline result\nAPI response + dashboard event", fillcolor = "#F2D45C"];
    CHAT  [label = "Chat service\nfollow-up dialogue", fillcolor = "white"];

    IN -> PRE -> MODE;

    MODE -> S_CAP   [label = "sequential", lhead = cluster_seq];
    MODE -> P_SPLIT [label = "parallel",   lhead = cluster_par];

    S_READY -> TRACK;
    P_JOIN  -> TRACK;

    TRACK -> SOM -> SG -> MEM -> OUT;
    MEM -> CHAT [style = dashed, label = "scene state"];
}

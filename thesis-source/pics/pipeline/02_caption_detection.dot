digraph PipelineStageCaptionDetection {
    rankdir = TB;
    splines = polyline;
    compound = true;
    nodesep = 0.35;
    ranksep = 0.6;
    pad = 0.45;
    bgcolor = "white";

    graph [fontname = "Helvetica";];
    node [fontname = "Helvetica"; fontsize = 11; shape = box; style = "rounded,filled"; color = "#000000"; penwidth = 1.2; margin = "0.14,0.10";];
    edge [fontname = "Helvetica"; fontsize = 8; color = "#000000"; penwidth = 1.0; arrowsize = 0.75;];

    IMAGE [label = "PIL image\nfrom API or worker request"; fillcolor = "#F2D45C";];
    CONTROLS [label = "PipelineControls\ncaption, detect,\nparallel_execution"; fillcolor = "white";];

    subgraph cluster_sequential {
        label = "Sequential mode";
        color = "#000000";
        penwidth = 1.4;
        style = "rounded";
        bgcolor = "#F7F7F7";

        S_CAPTION [label = "_run_caption()\nCaptionInferenceService.caption_image()"; fillcolor = "white";];
        S_DETECT [label = "_run_detection()\nDetectionService.detect()"; fillcolor = "white";];
        S_OUT [label = "caption text\n+ raw detections"; fillcolor = "#F2D45C";];

        S_CAPTION -> S_DETECT [label = "caption result retained";];
        S_DETECT -> S_OUT;
    }

    subgraph cluster_parallel {
        label = "Parallel mode";
        color = "#000000";
        penwidth = 1.4;
        style = "rounded";
        bgcolor = "#ECF4EA";

        COPY_CAP [label = "copy image for caption branch"; fillcolor = "white";];
        COPY_DET [label = "copy image for detect branch"; fillcolor = "white";];
        P_CAPTION [label = "caption task\nasync model/provider call"; fillcolor = "white";];
        P_DETECT [label = "detection task\nasyncio.to_thread()\n_detector_lock protects detector"; fillcolor = "white";];
        JOIN [label = "await detection,\nrun post-detection stages,\nthen await caption"; fillcolor = "white";];
        P_OUT [label = "caption text\n+ raw detections"; fillcolor = "#F2D45C";];

        COPY_CAP -> P_CAPTION;
        COPY_DET -> P_DETECT;
        P_CAPTION -> JOIN;
        P_DETECT -> JOIN;
        JOIN -> P_OUT;
    }

    IMAGE -> S_CAPTION [label = "parallel_execution=false";];
    IMAGE -> COPY_CAP [label = "parallel_execution=true";];
    IMAGE -> COPY_DET [label = "parallel_execution=true";];
    CONTROLS -> S_CAPTION [style = dashed;];
    CONTROLS -> COPY_CAP [style = dashed;];
    CONTROLS -> COPY_DET [style = dashed;];

    CAP_PROVIDER [label = "Caption backend\nlocal_hf / OpenAI-compatible /\nGemini"; fillcolor = "white";];
    DET_PROVIDER [label = "Detector backend\nYOLO / RT-DETR / RF-DETR /\nOWL-ViT + threshold + NMS"; fillcolor = "white";];

    S_CAPTION -> CAP_PROVIDER [style = dashed;];
    P_CAPTION -> CAP_PROVIDER [style = dashed;];
    S_DETECT -> DET_PROVIDER [style = dashed;];
    P_DETECT -> DET_PROVIDER [style = dashed;];
}

digraph PipelineStageMemoryQaResponse {
    rankdir = LR;
    splines = polyline;
    compound = true;
    nodesep = 0.35;
    ranksep = 0.65;
    pad = 0.45;
    bgcolor = "white";

    graph [fontname = "Helvetica";];
    node [fontname = "Helvetica"; fontsize = 11; shape = box; style = "rounded,filled"; color = "#000000"; penwidth = 1.2; margin = "0.14,0.10";];
    edge [fontname = "Helvetica"; fontsize = 8; color = "#000000"; penwidth = 1.0; arrowsize = 0.75;];

    IN [label = "stage outputs\ntracked detections,\ncaption text,\nscene graph,\nSoM image, metrics"; fillcolor = "#F2D45C";];

    subgraph cluster_updates {
        label = "Post graph updates";
        color = "#000000";
        penwidth = 1.4;
        style = "rounded";
        bgcolor = "#ECF4EA";

        QA_CTRL [label = "qa_generation enabled\nand graph non-empty?"; shape = diamond; fillcolor = "white";];
        QA [label = "SceneQAGenerationService\nstructured LLM output from\nexplicit graph facts"; fillcolor = "white";];
        CAP_MEM [label = "upsert caption memory\nSceneCaptionState\nframe_id / scan_id"; fillcolor = "white";];
        GRAPH_MEM [label = "update_scene_graph()\nstore relationship triples"; fillcolor = "white";];
        MEMORY [label = "SceneMemory state\nobjects, relations,\ncaptions, crops"; fillcolor = "#F2D45C";];
    }

    subgraph cluster_response {
        label = "Response and side effects";
        color = "#000000";
        penwidth = 1.4;
        style = "rounded";
        bgcolor = "#E8F0F7";

        RESULT [label = "PipelineResult\ndetections, graph, caption,\nQA pairs, executed_stages,\nmetrics"; fillcolor = "#F2D45C";];
        ADAPTER [label = "runtime adapter formats\nobjects, image_b64,\nmemory snapshot"; fillcolor = "white";];
        DETECT_SERVICE [label = "DetectService\nDetectionResponse to caller"; fillcolor = "white";];
        WS [label = "ws_manager broadcast\ndetection payload for dashboard"; fillcolor = "white";];
        PERSIST [label = "optional last_state persistence\nJSON + optional image"; fillcolor = "white";];
        QA_POOL [label = "QAPoolService ingest\npipeline-generated QA pairs"; fillcolor = "white";];
    }

    IN -> QA_CTRL;
    QA_CTRL -> QA [label = "true";];
    QA_CTRL -> RESULT [label = "false"; style = dashed;];
    IN -> CAP_MEM [label = "caption exists";];
    IN -> GRAPH_MEM [label = "update_scene_memory=true";];
    QA -> RESULT;
    CAP_MEM -> MEMORY;
    GRAPH_MEM -> MEMORY;
    MEMORY -> RESULT;
    RESULT -> ADAPTER;
    ADAPTER -> DETECT_SERVICE;
    DETECT_SERVICE -> WS [label = "publish=True";];
    DETECT_SERVICE -> PERSIST [label = "storage enabled";];
    DETECT_SERVICE -> QA_POOL [label = "QA pairs";];
}

digraph PipelineStageDialoguePathsClean {
    rankdir = LR;
//    splines = ortho;
  //  compound = true;
    nodesep = 0.30;
    ranksep = 0.45;
    pad = 0.35;
    bgcolor = "white";

    graph [fontname = "Helvetica"];
    node [
        fontname = "Helvetica",
        fontsize = 10,
        shape = box,
        style = "rounded,filled",
        color = "#000000",
        penwidth = 1.1,
        margin = "0.12,0.08"
    ];
    edge [
        fontname = "Helvetica",
        fontsize = 8,
        color = "#000000",
        penwidth = 1.0,
        arrowsize = 0.7
    ];

    MEMORY [
        label = "Scene memory\nobjects, relations,\ncaptions, crops",
        fillcolor = "#F2D45C"
    ];

    subgraph cluster_memory_chat {
        label = "Memory-grounded chat  (POST /api/v1/chat)";
        color = "#4E8B57";
        penwidth = 1.1;
        style = "rounded,dashed";
        bgcolor = "#ECF4EA";

        CHAT_REQ [
            label = "Chat request\nquery, chat_id, mode, language",
            fillcolor = "white"
        ];

        CHAT_PREP [
            label = "Language + conversation preparation\ninput enforcement and history loading",
            fillcolor = "white"
        ];

        CHAT_CONTEXT [
            label = "Context building\nmemory summary, recent captions,\nobject and relation facts",
            fillcolor = "white"
        ];

        CHAT_MODE [
            label = "Dialogue mode",
            shape = diamond,
            style = "filled",
            fillcolor = "#FFF2CC",
            margin = "0.08,0.05"
        ];

        GENERAL [
            label = "General prompt path",
            fillcolor = "white"
        ];

        OBJECT [
            label = "Object-focused path\nmatch object and gather facts",
            fillcolor = "white"
        ];

        FALLBACK [
            label = "Optional crop-caption fallback",
            fillcolor = "white"
        ];

        LLM [
            label = "LLM generation",
            fillcolor = "white"
        ];

        CHAT_OUT [
            label = "Chat response\nanswer + source metadata",
            fillcolor = "#F2D45C"
        ];

        CHAT_REQ -> CHAT_PREP -> CHAT_CONTEXT -> CHAT_MODE;
        CHAT_MODE -> GENERAL [label = "general"];
        CHAT_MODE -> OBJECT  [label = "object"];
        OBJECT -> FALLBACK [style = dashed, label = "if needed"];
        GENERAL -> LLM;
        OBJECT -> LLM;
        FALLBACK -> LLM [style = dashed];
        LLM -> CHAT_OUT;
    }

    subgraph cluster_vision_chat {
        label = "Image-direct vision chat  (POST /api/v1/vision_chat)";
        color = "#5A7FA6";
        penwidth = 1.1;
        style = "rounded,dashed";
        bgcolor = "#E8F0F7";

        V_REQ [
            label = "Vision-chat request\nimage, query, chat_id",
            fillcolor = "white"
        ];

        V_PREP [
            label = "Conversation preparation\nhistory text",
            fillcolor = "white"
        ];

        V_RUNTIME [
            label = "Runtime invocation\nin-process or worker",
            fillcolor = "white"
        ];

        VLM [
            label = "VLM generation\nimage + prompt",
            fillcolor = "white"
        ];

        V_OUT [
            label = "Vision-chat response\nanswer + provider metadata",
            fillcolor = "#F2D45C"
        ];

        V_REQ -> V_PREP -> V_RUNTIME -> VLM -> V_OUT;
    }

    WS [
        label = "Dashboard broadcast\nchat message update",
        fillcolor = "#F7F7F7"
    ];

    MEMORY -> CHAT_CONTEXT [label = "scene state"];
    MEMORY -> OBJECT [label = "object facts", style = dashed];

    CHAT_OUT -> WS;
    V_OUT -> WS;
}

digraph PipelineStageTrackingFusion {
    rankdir = LR;
    splines = polyline;
    compound = true;
    nodesep = 0.35;
    ranksep = 0.65;
    pad = 0.45;
    bgcolor = "white";

    graph [fontname = "Helvetica";];
    node [fontname = "Helvetica"; fontsize = 11; shape = box; style = "rounded,filled"; color = "#000000"; penwidth = 1.2; margin = "0.14,0.10";];
    edge [fontname = "Helvetica"; fontsize = 8; color = "#000000"; penwidth = 1.0; arrowsize = 0.75;];

    RAW [label = "raw detections\nlabel, confidence, bbox"; fillcolor = "#F2D45C";];
    CTRL [label = "pipeline_controls.track_memory"; shape = diamond; fillcolor = "white";];
    TEMP [label = "tracking disabled\nassign temporary per-frame ids"; fillcolor = "white";];

    subgraph cluster_memory_update {
        label = "SceneMemory.update()";
        color = "#000000";
        penwidth = 1.4;
        style = "rounded";
        bgcolor = "#ECF4EA";

        EXTRACT [label = "FeatureExtractor.extract_with_crops()\nobject crops + embeddings\noptional human ReID model"; fillcolor = "white";];
        ACTIVE [label = "load active tracks\nfrom SceneMemoryStore"; fillcolor = "white";];
        MATCH [label = "Associator.match()\nvisual + geometry weighted score"; fillcolor = "white";];
        UPDATE [label = "update matched tracks\ncopy object_id to detections\nstore last crop"; fillcolor = "white";];
        AGE [label = "age unmatched tracks\ndrop dormant tracks"; fillcolor = "white";];
        CREATE [label = "create tracks for\nunmatched detections"; fillcolor = "white";];
        FUSE [label = "fuse_people_perception()\nPepper people metadata,\nhead pose and camera geometry"; fillcolor = "white";];
        SYNTH [label = "create tracks for\nsynthetic Pepper-person detections"; fillcolor = "white";];
        OBJECTS [label = "update object state\nattributes, robot distance,\nlast_seen, hits"; fillcolor = "white";];
        PRUNE [label = "prune memory\nage and count limits"; fillcolor = "white";];
    }

    OUT [label = "tracked detections\nstable object_id values\n+ updated SceneMemory"; fillcolor = "#F2D45C";];

    RAW -> CTRL;
    CTRL -> TEMP [label = "false";];
    TEMP -> OUT;
    CTRL -> EXTRACT [label = "true";];
    EXTRACT -> ACTIVE;
    ACTIVE -> MATCH;
    MATCH -> UPDATE;
    MATCH -> AGE;
    UPDATE -> CREATE;
    AGE -> CREATE;
    CREATE -> FUSE;
    FUSE -> SYNTH;
    SYNTH -> OBJECTS;
    OBJECTS -> PRUNE;
    PRUNE -> OUT;
}

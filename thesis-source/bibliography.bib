@misc{aturhurra_leveraging_2024,
  title      = {Large Language Models for Human-Robot Interaction: Opportunities and Risks},
  url        = {http://arxiv.org/abs/2405.00693},
  doi        = {10.48550/arXiv.2405.00693},
  shorttitle = {Large Language Models for Human-Robot Interaction},
  abstract   = {The tremendous development in large language models ({LLM}) has led to a new wave of innovations and applications and yielded research results that were initially forecast to take longer. In this work, we tap into these recent developments and present a meta-study about the potential of large language models if deployed in social robots. We place particular emphasis on the applications of social robots: education, healthcare, and entertainment. Before being deployed in social robots, we also study how these language models could be safely trained to ``understand'' societal norms and issues, such as trust, bias, ethics, cognition, and teamwork. We hope this study provides a resourceful guide to other robotics researchers interested in incorporating language models in their robots.},
  number     = {{arXiv}:2405.00693},
  publisher  = {{arXiv}},
  author     = {Atuhurra, Jesse},
  urldate    = {2026-04-21},
  date       = {2024-03-26},
  eprinttype = {arxiv},
  eprint     = {2405.00693 [cs]},
  note       = {version: 1},
  keywords   = {Computer Science - Computation and Language, Computer Science - Robotics},
  file       = {Full Text PDF:/home/jakub-ciesko/Zotero/storage/EJ6F4MRK/Atuhurra - 2024 - Large Language Models for Human-Robot Interaction Opportunities and Risks.pdf:application/pdf;Snapshot:/home/jakub-ciesko/Zotero/storage/CN992L9C/2405.html:text/html}
}


@misc{peng_object_2024,
  title      = {Object Permanence Filter for Robust Tracking with Interactive Robots},
  url        = {http://arxiv.org/abs/2403.08231},
  doi        = {10.48550/arXiv.2403.08231},
  abstract   = {Object permanence, which refers to the concept that objects continue to exist even when they are no longer perceivable through the senses, is a crucial aspect of human cognitive development. In this work, we seek to incorporate this understanding into interactive robots by proposing a set of assumptions and rules to represent object permanence in multi-object, multi-agent interactive scenarios. We integrate these rules into the particle filter, resulting in the Object Permanence Filter ({OPF}). For multi-object scenarios, we propose an ensemble of K interconnected {OPFs}, where each filter predicts plausible object tracks that are resilient to missing, noisy, and kinematically or dynamically infeasible measurements, thus bringing perceptional robustness. Through several interactive scenarios, we demonstrate that the proposed {OPF} approach provides robust tracking in human-robot interactive tasks agnostic to measurement type, even in the presence of prolonged and complete occlusion. Webpage: https://opfilter.github.io/.},
  number     = {{arXiv}:2403.08231},
  publisher  = {{arXiv}},
  author     = {Peng, Shaoting and Wang, Margaret X. and Shah, Julie A. and Figueroa, Nadia},
  urldate    = {2026-04-21},
  date       = {2024-03-13},
  eprinttype = {arxiv},
  eprint     = {2403.08231 [cs]},
  keywords   = {Computer Science - Robotics},
  annotation = {Comment: 2024 {IEEE} International Conference on Robotics and Automation ({ICRA})},
  file       = {Full Text PDF:/home/jakub-ciesko/Zotero/storage/WL9W82X5/Peng et al. - 2024 - Object Permanence Filter for Robust Tracking with Interactive Robots.pdf:application/pdf;Snapshot:/home/jakub-ciesko/Zotero/storage/PL97I6NW/2403.html:text/html}
}

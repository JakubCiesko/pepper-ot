  note       = {version: 1},
  keywords   = {Computer Science - Robotics, Computer Science - Human-Computer Interaction, Electrical Engineering and Systems Science - Audio and Speech Processing},
  file       = {Full Text PDF:/home/jakub-ciesko/Zotero/storage/XBQ7KZ9U/Wilson et al. - 2025 - Enhancing the NAO Extending Capabilities of Legacy Robots for Long-Term Research.pdf:application/pdf;Snapshot:/home/jakub-ciesko/Zotero/storage/2Z9YFXDG/2509.html:text/html}

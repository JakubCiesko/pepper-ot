  keywords   = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Robotics},
  file       = {Full Text PDF:/home/jakub-ciesko/Zotero/storage/BF63K252/Zhong et al. - 2024 - Improving Visual Perception of a Social Robot for Controlled and In-the-wild Human-robot Interaction.pdf:application/pdf;Snapshot:/home/jakub-ciesko/Zotero/storage/FX5MWZFF/2403.html:text/html}

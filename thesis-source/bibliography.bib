  eprinttype = {arxiv},
  eprint     = {2209.07753 [cs]},
  keywords   = {Computer Science - Robotics},
  file       = {PDF:/home/jakub-ciesko/Zotero/storage/N494STQK/Liang et al. - 2023 - Code as Policies Language Model Programs for Embodied Control.pdf:application/pdf}

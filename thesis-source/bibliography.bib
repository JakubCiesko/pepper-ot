@article{trinquet_future_2025,
  title        = {The future of libraries: Integrating pepper and computer vision for smart assistance},
  volume       = {27},
  issn         = {2590-0056},
  url          = {https://www.sciencedirect.com/science/article/pii/S2590005625000967},
  doi          = {10.1016/j.array.2025.100469},
  shorttitle   = {The future of libraries},
  abstract     = {In recent decades, the utilization of social robots in our daily lives has increased, but they are different from robots designed for libraries. On the one hand, library robots cannot establish social interactions, while social robots lack the necessary sensors to identify books. The present study aims to integrate the social robot Pepper's camera with computer vision techniques to enable Pepper to read the titles of books in front of it. This involves two main steps. The first step is to detect objects, i.e. books, from the scene. Thereafter, the titles of the books need to be read from the previous step. To achieve the first objective, two object detection models, {YOLOv}4 and {YOLOv}9, were employed. To accomplish the second goal, three {OCR} models —{EasyOCR}, Pytesseract, and Keras-{OCR} — were used. The results indicate that with the {YOLOv}9 model, all books were detected, whereas with the {YOLOv}4 model, 94 \% books were identified. The findings of the present study suggest that when the {YOLOv}4 model and {YOLOv}9 were applied, {EasyOCR} performed well at a distance of 50 cm with a resolution of 3. Although the results of the {OCR} do not match perfectly with the written text on the books, the error rate is quite low for recognition by humans and computers. Therefore, there is a need to employ more advanced object detection and {OCR} technologies in future work.},
  pages        = {100469},
  journaltitle = {Array},
  shortjournal = {Array},
  author       = {Trinquet, Claire and Mishra, Deepti and Pande, Akshara},
  urldate      = {2026-01-13},
  date         = {2025-09-01},
  keywords     = {Object detection, Computer vision, {OCR}, Pepper, Social robots},
  annotation   = {interesting use case of {OD} + {OCR}
                  },
  annotation   = {Object detection on remote machine
                  },
  file         = {ScienceDirect Full Text PDF:/home/jakub-ciesko/Zotero/storage/T4CD8EXE/Trinquet et al. - 2025 - The future of libraries Integrating pepper and computer vision for smart assistance.pdf:application/pdf;ScienceDirect Snapshot:/home/jakub-ciesko/Zotero/storage/2K5L78GB/S2590005625000967.html:text/html}
}


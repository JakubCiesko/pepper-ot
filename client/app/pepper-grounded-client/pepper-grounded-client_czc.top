    "ukaž dashboard"
    "otevři dashboard"
    "ukaž svuj dashboard"
]

u:(~look)
    "Dobře."
    ^pCall(PepperGroundedClient.look("cs"))

u:(~scan)
    "Dej mi chvilku, jen se pořádně rozhlédnu"
    ^pCall(PepperGroundedClient.scan("cs"))

u:(~reset_session)
    "Tak fajn. Už si nic nepamatuju."
    ^pCall(PepperGroundedClient.resetConversation())

u:(~show_dashboard)
    ^sCall(PepperGroundedClient.showDashboard())

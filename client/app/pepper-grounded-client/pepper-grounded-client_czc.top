    "co vidíš"
    "co kolem sebe vidíš"
    "podívej se"
    "mrkni se"
    "co vidíš před sebou"
    "popiš co vidíš"
    "popiš co teď vidíš"
    "co se kolem tebe děje"
    "řekni co vidíš"
    "řekni co se před tebou děje"
    "řekni co se děje"
    "popiš co se děje"
    "popiš co se teď děje"
]



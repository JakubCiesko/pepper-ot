topic: ~pepper-grounded-client()
language: enu

# dynamic concepts
dynamic: memory_objects
dynamic: memory_attributes
dynamic: memory_relations
dynamic: memory_cached_questions

# system introduction
concept:(question_prefix) [
    "how do you"
    "how can you"
    "how you"
]

concept:(vision_action) [
    know what is around you
    understand what is around you
    know your surroundings
    see
    perceive
    see the scene
    see your surroundings
    analyze the scene
    understand the scene
    understand the environment
    understand your surroundings
    perceive the environment
    perceive the scene
    perceive your surroundings
    process images

]

concept:(explain_system)[
    "~question_prefix ~vision_action"
    "how does {your} vision {system} work"
]



u:(~explain_system)
    ^mode(contextual)
    ^rand["I am glad you ask." "That is a good question." ""]
    ^runTag(explain)
    I use cameras and artificial intelligence to understand my surroundings.

    ^run(animations/Stand/Gestures/Explain_1)
    I take images and send them to a server for processing.

    ^run(animations/Stand/Gestures/YouKnowWhat_1)
    The server detects objects, their attributes, and relationships between them.

    ^run(animations/Stand/Gestures/Explain_2)
    Then I organize this information into a structured representation of the scene

    ^run(animations/Stand/Gestures/YouKnowWhat_6)
    This allows me to answer questions about what I see and how things are related.
    ^runTag(you)
    You can ask me more about how I work.
    u1:(["what can I ask" "what questions can I ask" "what can you tell me" "what else" "more" "continue" "anything else"])
        ^runTag(explain)
        ["You can ask about speed detection scanning or memory" "You can ask me about what I see, how fast I am, how I process the scene, or what I remember"]
        What would you like to know?
        ^stayInScope
        u2:(["speed" "how fast {are you}"])
            ^goto(speed)

        u2:(["detection" "objects" "what {do} you see"])
            ^goto(objects)

        u2:(["scan" "scanning" "how {do} you process {the} scene"])
            ^goto(scan)

        u2:(["memory" "how do you remember" "what do you remember"])
            ^goto(memory)

        u2:(["{okay} thank you" "thanks" "I know {everything} {now}"])
            ^goto(exit)

    u1:(["what objects can you detect" "what do you recognize" "what can you see"]) %objects
        ^runTag(explain)
        I can recognize many common objects such as chairs, tables, screens, books, and more.

        ^run(animations/Stand/Gestures/Show_1)
        If the objects are visible and clear, I will try to detect them.
        ^stayInScope
    u1:(["how fast are you" "are you fast" "is it quick" "how long does it take"]) %speed
        ^run(animations/Stand/Gestures/Explain_4)
        A quick look is usually fast.

        ^run(animations/Stand/Gestures/Explain_2)
        A full scan takes a few seconds because multiple images need to be processed.
        During that time, I am still working even if I am silent.
        ^stayInScope
   u1:(["what is a full scan" "what does scan mean" "what is scanning"]) %scan
        ^runTag(explain)
        A scan means I observe the environment from multiple directions. I will look around like this
        ^run(animations/Stand/Gestures/LookAround_1)
        Then I combine the observations into a more complete understanding of the scene.
        A quick look is a faster alternative of the full scan
        ^stayInScope

    u1:(["can you remember things" "do you remember" "do you have memory"]) %memory
        ^run(animations/Stand/Gestures/No_1)
        I do not store information permanently by myself.

        ^run(animations/Stand/Gestures/ShowSky_1)
        However, the server can store information for me.

        ^runTag(explain)
        I can use that stored information to answer your questions later.

        u1:(["can I ask questions" "what can I ask" "how can I use you"])
        ^run(animations/Stand/Gestures/You_1)
        You can ask me what I see.

        ^run(animations/Stand/Gestures/Show_2)
        You can ask where objects are.

        ^run(animations/Stand/Gestures/Explain_1)
        Or you can ask what is happening in the scene.

        ^runTag(yes)
        I will try to answer as accurately as possible.
        ^stayInScope
    u1:(["{okay} thank you" "thanks" "I know {everything} {now}"]) %exit
        You are welcome
        Let's start talking about what I see then


# perception
# this is just one fast scan of the scene
concept:(quick_look_action) [
    "what do you see"
    "what can you see"
    "what do you see now"
    "look around"
    "look"
    "check"
    "check the scene"
    "describe what you see"
    "describe the scene"
    "what is here"
    "what is in front of you"
    "do you see anything"
    "tell me what is here"
    "tell me what you see"
]

concept:(panorama_scan_action) [
    "scan the room"
    "scan around"
    "do a full scan"
    "full scan"
    "panorama scan"
    "look everywhere"
    "look around the room"
    "scan everything {closely}"
    "analyze the whole room"
    "check everything"
    "scan closely"
    "look closely"
]

concept:(quick_look) [
    "{please} ~quick_look_action"
    "can you {please} ~quick_look_action"
    "could you {please} ~quick_look_action"
]

concept:(panorama_scan) [
    "{please} ~panorama_scan_action"
    "can you {please} ~panorama_scan_action"
    "could you {please} ~panorama_scan_action"
]

u:(~quick_look)
    ^mode(contextual)
    ^rand[
        "Okay I will take a quick look."
        "Let me take a quick look."
        "I will check the scene."
    ]
    ^pCall(PepperGroundedClient.look("en"))
    ^runTag(look)
    This will take {just} a [moment second].

u:(~panorama_scan)
    ^mode(contextual)
    ^rand[
        "Oosh Okay I will scan the room."
        "Starting a full scan."
        "I will analyze the whole environment."
    ]
    ^pCall(PepperGroundedClient.scan("en"))
    This may take a few [seconds moments]. ["Please be patient" "Don't go anywhere" ""]


# memory

# shows memory state on tablet
concept:(show_memory_graph) [
    "[show open display present] {to me the} memory {graph}"
    "[show open display present] {to me the} scene graph"
    "what do you {currently} remember"
    "show what you remember"
    "what is in {your} memory"
]


u:(~show_memory_graph)
    ^mode(contextual)
    ^rand[
        "Okay showing memory."
        "Let me show you what I remember."
        "Opening memory view."
        "Watch my tablet"
        "Look at my tablet"
    ]
    ^run(animations/Stand/Gestures/ShowTablet_3)
    ^pCall(PepperGroundedClient.showMemory("en"))
    u1:(["[refresh update reload] [concepts memory graph]"])
        Okay I will refresh my memory.
        ^pCall(PepperGroundedClient.refreshMemoryConcepts("en"))


concept:(reset_memory_only) [
    "[reset clear delete] {visual scene} memory"
    "forget what you saw"
    "forget visual memory"
]

u:(~reset_memory_only)
    ^mode(contextual)
    ^run(animations/Stand/Gestures/Think_1)
    Do you really want me to clear my memory?

    u1:(["yes" "yes do it" "confirm" "go ahead" "delete" "clear"])
        ^runTag(yes)
        Okay I will clear my memory.
        ^pCall(PepperGroundedClient.resetMemory("en"))

    u1:(["no" "cancel" "stop"])
        ^runTag(no)
        Okay I will keep my memory.

concept:(reset_conversation_only) [
    "[reset clear delete restart] {the} conversation"
    "start a new conversation"
    "forget the conversation"
    "new conversation {please}"
]
u:(~reset_conversation_only)
    ^runTag(explain)
    Okay ["I will reset the conversation" "we can start over"]
    ^pCall(PepperGroundedClient.resetConversation())

concept:(reset_all) [
    "start over"
    "let us start over"
    "let's start over"
    "start from scratch"
    "let us talk from scratch"
    "let's talk from scratch"
]


u:(~reset_all)
    ^run(animations/Stand/Gestures/Think_1)
    This will clear memory and restart everything. Do you want to continue?

    u1:(["yes" "confirm" "do it"])
        ^runTag(yes)
        Okay restarting everything.

        ^pCall(PepperGroundedClient.resetMemory("en"))
        ^pCall(PepperGroundedClient.resetConversation())

    u1:(["no" "cancel"])
        ^runTag(no)
        Okay I will not reset anything.


concept:(refresh_memory_concepts) [
    "[refresh update] memory"
    "[refresh update] memory [words concepts]"
    "refresh memory words"
    "update memory words"
    "refresh memory concepts"
    "update memory concepts"
    "reload memory words"
    "reload memory concepts"
]


u:(~refresh_memory_concepts)
    ^runTag(explain)
    I will refresh my memory representation.
    ^pCall(PepperGroundedClient.refreshMemoryConcepts("en"))


# dynamic concept conversation
concept:(object_query_lead) [
    "tell me about"
    "what do you know about"
    "what can you [say tell] {me} about"
    "describe {the}"
    "say everything {what} you know about"
]

concept:(object_query_prefix) [
    "can you"
    "could you"
    "please"
    "please can you"
    "would you"
]


u:({~object_query_prefix} ~object_query_lead _~memory_objects {please})
    ^mode(contextual)
    ^runTag(explain)
    ^pCall(PepperGroundedClient.askAboutObject("en", $1))
    Okay I will focus on the $1.
    $last_object=$1
    ["Let me think about it for a while" "I will just think about it" "Just give me a second to think about it" "Let's just wait for the server to tell me more about it" ""]
    u1:(["tell me more {please}" "what else {please}" "more details" "anything else"])
        ^pCall(PepperGroundedClient.askAboutObject("en", $last_object))
        ["Well of course" "Just a second" "Surely there is more to talk about"]
        ^stayInScope
    u1:(["and what about" "what about"] _~memory_objects)
        $last_object=$1
        ^runTag(explain)
        Now focusing on the $1. Let me think
        ^pCall(PepperGroundedClient.askAboutObject("en", $1))
        ^stayInScope
    u1:(["{wow} that was interesting" "thanks" "{let's} focus on {something} else"])
        No problem, let's talk about something else

# with fallbacks dynamic concepts

u:([what which list] [objects things] {do} you see)
    ^pCall(PepperGroundedClient.listObjects("en"))

u:([what which list] [attributes] {do} you see)
    ^pCall(PepperGroundedClient.listAttributes("en"))

u:([what which list] [relations] {do} you see)
    ^pCall(PepperGroundedClient.listRelations("en"))



concept:(counts) [
   "{"tell me"} how many"
   "{"tell me" the} count"
    "{"tell me" the} number {of}"
]
u:(~counts _~memory_objects)
    $query="how many $1"
    ^pCall(PepperGroundedClient.ask("en", $query))
    Perfect question let me count $1 really fast

u:(~counts _*)
    $query="how many $1" # do you see or remember
    ^pCall(PepperGroundedClient.ask("en", $query))
    Perfect question let me count the objects really fast

concept:(present) [
    "do you see {any}"
    "can you see {any}"
    "is there"
    "is any"
]
u:(~present _~memory_objects {there})
    $query="do you see $1"
    ^pCall(PepperGroundedClient.ask("en", $query))
    I sure do

u:(~present _*)
    $query="do you see $1"
    ^pCall(PepperGroundedClient.ask("en", $query))
    Let me see


concept:(position) [
    "where [is are] {the}"
    "where can I find {the}"
    "in what position [is are] {the}"
    "what is {the} [position place] of {the}"
]
u:(~position _~memory_objects)
    $query="where is $1 located"
    ^pCall(PepperGroundedClient.ask("en", $query))
    I surely know it is somewhere, but I need to think.

u:(~position _*)
    $query="where is $1 located"
    ^pCall(PepperGroundedClient.ask("en", $query))
    Let me think


u:(["what is happening" "describe the situation"])
    $query="describe the scene and what is happening"
    ^pCall(PepperGroundedClient.ask("en", $query))


concept:(color) [
    red blue green yellow black white gray brown orange purple pink
]
concept:(size) [
    big small large tiny huge tall short
]
concept:(shape) [
    round square rectangular flat long thin
]
concept:(state) [
    open closed empty full broken clean dirty
]
concept:(material) [
    wooden metal plastic glass
]

concept:(attribute) [
    ~color
    ~size
    ~shape
    ~state
    ~material
]

u:("[what which] [color colour] is" _~memory_objects)
    $query="what color is $1"
    ^pCall(PepperGroundedClient.ask("en", $query))
    Colors, there is plenty of them.


u:("[what which] [objects things] [is are]" _~attribute)
    $query="which objects are $1"
    ^pCall(PepperGroundedClient.ask("en", $query))
    Now! that is a question! Let me mine my own memory.

u:(["how is" "what is"] {the} _~memory_objects {like})
    $query="what is $1 like"
    ^pCall(PepperGroundedClient.ask("en", $query))

u:("[what which] [relation relations attributes] [is are has have]" _~memory_objects {in})
    $query="What relations and attributes do $1 have"
    ^pCall(PepperGroundedClient.ask("en", $query))
    I like $1! But this is really complex. Give me a moment.


u:("[does is] [anything anybody anyone] {have} {the relation of}" _~memory_relations)
    $query="Does anybody have relation or attribute $1 . If so, state who or what is it."
    ^pCall(PepperGroundedClient.ask("en", $query))
    $1 is an interesting relation right? Let me think


# cached_qa
concept:(ask_suggested_questions) [
    "what can [i I] ask"
    "suggest questions"
    "show suggested questions"
    "what questions do you have {prepared}"
    "give {me} [example sample] questions"
    "show {me} [quick fast] questions"
]

u:(~ask_suggested_questions)
    "Okay I will show suggested questions from memory."
    ^pCall(PepperGroundedClient.showMemoryAndSuggestQuestions("en"))

u:(_~memory_cached_questions)
    ^pCall(PepperGroundedClient.answerCachedQuestion("en", $1))


u:(["Let me ask {this question}" "Tell me" "Answer me {this} question"] _*)
    I am on it
    ^pCall(PepperGroundedClient.ask("en", $1))

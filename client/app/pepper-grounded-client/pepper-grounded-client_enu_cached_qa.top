concept:(ask_suggested_questions) [
    "what can I ask"
    "what can i ask"
    "suggest questions"
    "show suggested questions"
    "what questions do you have"
    "give me example questions"
    "give me sample questions"
    "show quick questions"
    "show fast questions"
]

u:(~ask_suggested_questions)
    "Okay I will show suggested questions from memory."
    ^sCall(PepperGroundedClient.showMemory("en"))
    u1:(_~memory_cached_questions)
        ^sCall(PepperGroundedClient.answerCachedQuestion("en", $1))

u:(_~memory_cached_questions)
    ^sCall(PepperGroundedClient.answerCachedQuestion("en", $1))

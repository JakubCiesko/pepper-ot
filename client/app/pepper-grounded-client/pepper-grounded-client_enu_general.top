concept:(show_dashboard) [
    "show the dashboard"
    "open the dashboard"
    "show your dashboard"
    "open your dashboard"
]

u:(~show_dashboard)
    ^sCall(PepperGroundedClient.showDashboard())

u:(["refresh and" "first refresh and" "refresh then"] _*)
    ^sCall(PepperGroundedClient.refreshAndAsk("en", $1))

u:(["ask" "question"] _*)
    ^sCall(PepperGroundedClient.ask("en", $1))

u:(_*)
    ^sCall(PepperGroundedClient.ask("en", $1))

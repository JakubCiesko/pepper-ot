    "color_space": 11,
    "fps": 10,
    "frame_prefix": "pepper_frame",
    "head_move_speed": 0.15,
    "jpeg_quality": 90,
    "refresh_ttl_seconds": 25,
    "resolution": 2,
    "scan_head_pitch": -0.1,
    "scan_prefix": "pepper_scan",
    "scan_summary_query_cs": "Stručne popíš, co teď vidíš na základě aktuální vizuální paměti.",
    "scan_summary_query_en": "Briefly describe what you can see now using the current visual memory.",
    "scan_yaws_deg": [
      -35,
      0,
      35
    ],
    "settle_seconds": 0.6,
    "fake_camera": true,
    "fake_camera_path": "/home/jakub-ciesko/Desktop/test-imgs/test/one"
  },
  "dialog": {
    "enable_dynamic_memory_concepts": true,
    "language_code": "auto",
    "memory_attributes_max": 100,
    "memory_cached_questions_max": 60,
    "memory_objects_max": 100,
    "memory_relations_max": 100,
    "refresh_after_detect": true,
    "refresh_after_reset": true,
    "refresh_after_scan": true
  },
  "language": {
    "default_dialog_language": "auto",
    "output_language_mode": "auto"
  },
  "panorama": {
    "enabled": true,
    "mode": "panorama_detect",
    "render_limit": 5,
    "stick_together": true,
    "summary_after_scan": true
  },
  "server": {
    "base_url": "https://raye-uncontractile-attently.ngrok-free.dev",
    "caption_path": "/api/v1/caption",
    "caption_timeout_seconds": 60,
    "chat_path": "/api/v1/chat",

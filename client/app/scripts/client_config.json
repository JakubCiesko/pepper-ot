{
  "app": {
    "app_id": "PepperGroundedClient",
    "service_name": "PepperGroundedClient"
  },
  "behavior": {
    "allow_scan_summary_chat": true,
    "auto_refresh_before_chat": false,
    "auto_restore_head_pose": true,
    "caption_retry_on_timeout": true,
